# ============================================================
# Environment Configuration
# Copy this file to .env and fill in real values before running.
# ============================================================

DATABASE_URL=postgresql://dataset_user:strongpassword@localhost/dataset_db
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

# Local storage directory for generated datasets
STORAGE_DIR=local_storage

# Ollama / LLM API URL
OLLAMA_API_URL=http://localhost:11434/api/generate

# Debug mode (set to true for development)
DEBUG=false
